{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ea-stodjare/project-metamodel.schema.json",
  "title": "EA Stödjare v2 project metamodel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_metamodel"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_metamodel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "base_profile",
        "object_types",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "base_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "compatibility_mode": {
              "type": "string",
              "enum": [
                "native",
                "legacy",
                "extended_legacy",
                "custom"
              ]
            }
          }
        },
        "object_types": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "disabled",
            "custom"
          ],
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "custom": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/customObjectType"
              }
            }
          }
        },
        "attribute_extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attributeExtension"
          },
          "default": []
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "disabled",
            "custom"
          ],
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "custom": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/customRelation"
              }
            }
          }
        },
        "relation_qualifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationQualifier"
          },
          "default": []
        },
        "value_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueSet"
          },
          "default": []
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionRef"
          },
          "default": []
        },
        "derived_views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivedView"
          },
          "default": []
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contract": {
              "type": [
                "string",
                "null"
              ]
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "object_display_pattern": {
              "type": "string"
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "change_control": {
              "type": "boolean"
            },
            "baseline_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "freeze_status": {
              "type": "string",
              "enum": [
                "draft",
                "review",
                "frozen",
                "reopened",
                "retired",
                "not_applicable"
              ]
            },
            "baseline_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "retired_id_registry": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_changelog": {
              "type": [
                "string",
                "null"
              ]
            },
            "metamodel_changelog": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "object",
            "array",
            "enum",
            "reference",
            "embedded"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "value_set": {
          "type": "string"
        },
        "reference_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "item_type": {
          "type": "string"
        }
      }
    },
    "customObjectType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id_prefix",
        "definition",
        "attributes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "display_name": {
          "type": "string"
        },
        "id_prefix": {
          "type": "string",
          "minLength": 2
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        },
        "provenance_required": {
          "type": "boolean"
        },
        "status_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "model_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+\\.yaml$"
        }
      }
    },
    "attributeExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "attributes"
      ],
      "properties": {
        "object_type": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        }
      }
    },
    "endpointRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "customRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "definition",
        "endpoints"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "display_name": {
          "type": "string"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpointRule"
          },
          "minItems": 1
        },
        "inverse": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_required": {
          "type": "boolean"
        }
      }
    },
    "relationQualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "applies_to",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "enum",
            "number"
          ]
        },
        "value_set": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "valueSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "extension_of": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "extensionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "derivedView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_of_truth",
        "join_path",
        "regeneration_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source_of_truth": {
          "const": false
        },
        "join_path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "filters": {
          "type": "object",
          "additionalProperties": true
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "presentation_semantics": {
          "type": "object",
          "additionalProperties": true
        },
        "regeneration_policy": {
          "type": "string",
          "enum": [
            "always",
            "on_source_change",
            "manual_rebuild"
          ]
        }
      }
    }
  }
}
