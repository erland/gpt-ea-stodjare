{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-stodjare.local/schemas/semantic-eval.schema.json",
  "title": "EA Stödjare semantic eval case schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "title",
    "tags",
    "prompt",
    "expected_behaviors",
    "forbidden_behaviors",
    "grading_criteria",
    "critical_failures",
    "notes"
  ],
  "properties": {
    "format": {
      "const": "ea-stodjare-semantic-eval-case"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EVAL-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 10
    },
    "expected_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "forbidden_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "grading_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVAL-[0-9]{3}-C[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
