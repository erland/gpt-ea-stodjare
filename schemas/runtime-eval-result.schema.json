{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-stodjare.local/schemas/runtime-eval-result.schema.json",
  "title": "EA Stödjare runtime semantic eval result",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "target", "executed_at", "cases"],
  "properties": {
    "format": {"const": "ea-stodjare-runtime-eval-result"},
    "version": {"const": "1.0"},
    "target": {"type": "string", "minLength": 1},
    "executed_at": {"type": ["string", "null"]},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "response", "criteria", "critical_failures"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVAL-[0-9]{3}$"},
          "response": {"type": "string"},
          "criteria": {
            "type": "object",
            "additionalProperties": {"type": "boolean"}
          },
          "critical_failures": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
